# Server Configuration
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0
LOG_LEVEL=info

# Database Configuration
# SQLite local default, or PostgreSQL: postgresql://postgres:postgres@localhost:5432/billing
DATABASE_URL=sqlite:///./billing.db

# Stripe Configuration (Test Mode Only)
# Get your test keys at https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_placeholder_key_never_commit_real_keys
STRIPE_WEBHOOK_SECRET=whsec_placeholder_secret_for_local_testing

# Application Settings
DEFAULT_CURRENCY=usd
METERING_RETENTION_DAYS=90
